<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
 
    <!-- Tell IIS to hand all requests to Node via iisnode -->
    <handlers>
      <add name="iisnode" path="server/index.js" verb="*" modules="iisnode"/>
    </handlers>
 
    <rewrite>
      <rules>
 
        <!-- Don't interfere with Node inspector -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server/index.js\/debug[\/]?" />
        </rule>
 
        <!-- Serve static files from client/dist directly -->
        <rule name="StaticContent" stopProcessing="true">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile"/>
          </conditions>
          <action type="None"/>
        </rule>
 
        <!-- All API calls go to Node -->
        <rule name="APIRequests" stopProcessing="true">
          <match url="^api/.*" />
          <action type="Rewrite" url="server/index.js"/>
        </rule>
 
        <!-- Everything else → Node (which serves client/dist/index.html) -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True"/>
          </conditions>
          <action type="Rewrite" url="server/index.js"/>
        </rule>
 
      </rules>
    </rewrite>
 
    <!-- Required for iisnode to work correctly -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin"/>
        </hiddenSegments>
      </requestFiltering>
    </security>
 
    <httpErrors existingResponse="PassThrough"/>
 
    <!-- Optional: increase timeout for long-running agents -->
    <iisnode
      nodeProcessCommandLine="node.exe"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      watchedFiles="*.js;iisnode.yml"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
    />
 
  </system.webServer>
</configuration>